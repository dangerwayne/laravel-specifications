{
    "name": "dangerwayne/laravel-specifications",
    "description": "Elegant specification pattern implementation for Laravel with support for Eloquent queries and in-memory filtering",
    "homepage": "https://laravel-specifications-doc.netlify.app",
    "support": {
        "docs": "https://laravel-specifications-doc.netlify.app",
        "source": "https://github.com/dangerwayne/laravel-specifications"
    },
    "keywords": [
        "laravel",
        "specification",
        "pattern",
        "ddd",
        "domain-driven-design",
        "business-rules"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Barry Stovall",
            "email": "bw.stovall@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/collections": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "phpstan/phpstan": "^1.10",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "DangerWayne\\Specification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DangerWayne\\Specification\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format-check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DangerWayne\\Specification\\Providers\\SpecificationServiceProvider"
            ],
            "aliases": {
                "Specification": "DangerWayne\\Specification\\Facades\\Specification"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
